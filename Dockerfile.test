# Test image: runs the unit tests plus the local e2e suite (fast, fake
# Gotenberg). pytest collects both, so one run is the whole suite.
# The build fails if the suite is red.
#   docker build -f Dockerfile.test -t email-to-print:test .
# MOX_VERSION default matches tests/conftest.py (single source); override
# with --build-arg if they ever drift.
ARG MOX_VERSION=v0.0.17
FROM golang:1-bookworm AS moxbuild
ARG MOX_VERSION
RUN GOBIN=/out go install github.com/mjl-/mox@v${MOX_VERSION}

FROM python:3.14-slim
WORKDIR /repo
# keep the relative layout: tests/requirements_test.txt includes
# ../poller/requirements.txt
COPY poller/requirements.txt poller/requirements.txt
COPY tests/requirements_test.txt tests/requirements_test.txt
RUN pip install --no-cache-dir -r tests/requirements_test.txt
COPY --from=moxbuild /out/mox /usr/local/bin/mox
COPY . .
ENV MOX_BIN=/usr/local/bin/mox
RUN python -m pytest -m "not slow"
