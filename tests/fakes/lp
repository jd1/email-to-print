#!/usr/bin/env python3
"""Fake `lp` (CUPS client) for tests.

Records every invocation's argv in $SPPOOL/calls.jsonl (attempts included)
and, on success, copies the file being printed (last argv entry, after `--`)
into $SPPOOL with a numbered prefix. Exits 0 like a successful lp.
Set FAKE_LP_FAIL=1 to exit 1 with an error on stderr instead (nothing is
spooled, but the attempt is still recorded).
"""
import json, os, shutil, sys

spool = os.environ["SPPOOL"]
os.makedirs(spool, exist_ok=True)
args = sys.argv[1:]
path = args[-1]
with open(os.path.join(spool, "calls.jsonl"), "a") as f:
    f.write(json.dumps(args) + "\n")

if os.environ.get("FAKE_LP_FAIL") == "1":
    print("lp: Unable to contact CUPS server", file=sys.stderr)
    sys.exit(1)

idx = 0
while os.path.exists(os.path.join(spool, f"{idx:03d}-{os.path.basename(path)}")):
    idx += 1
shutil.copyfile(path, os.path.join(spool, f"{idx:03d}-{os.path.basename(path)}"))
print(f"request id is fake-{idx} (1 file)")
